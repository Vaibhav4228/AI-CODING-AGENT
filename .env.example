# Workspace preview and offline checks require no keys.
# Future local developer inference (customer keys belong in VS Code SecretStorage).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Optional JEV sidecar (currently heuristic).
JEV_GATEWAY_PORT=8001
TYPESAFE_API_KEY=

# Optional legacy HTTP server and checkpoint smoke check.
NODE_ENV=development
PORT=5000
DB_URL=
COOKIE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CALL_BACK_URL=http://localhost:5000/auth/github/callback
FRONT_APP_URL=

# Optional hosted retrieval.
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0
PINECONE_API_KEY=
PINECONE_INDEX=
